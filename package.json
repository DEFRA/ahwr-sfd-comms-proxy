{
  "name": "ahwr-sfd-comms-proxy",
  "version": "0.0.0",
  "description": "ahwr-sfd-comms-proxy",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.23.1",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json}\"",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:knip": "knip --production --exclude exports",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run setup:husky",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "PORT=3933 jest --runInBand",
    "test:watch": "PORT=3933 TZ=UTC vitest"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1101.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "ffc-ahwr-common-library": "3.8.5",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "http-status-codes": "2.3.0",
    "joi": "18.2.3",
    "mongo-locks": "3.2.0",
    "mongodb": "7.5.0",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3"
  },
  "overrides": {
    "brace-expansion": "2.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "autoprefixer": "10.5.4",
    "babel-jest": "30.4.1",
    "babel-plugin-transform-import-meta": "2.3.3",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-junit": "17.0.0",
    "knip": "6.31.0",
    "mongodb-memory-server": "11.2.0",
    "nano-staged": "1.0.2",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6"
  },
  "nano-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
